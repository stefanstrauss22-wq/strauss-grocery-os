# --- Database ---
# Leave unset for local dev: an embedded PGlite database is created in server/data/
# For Supabase: Project Settings -> Database -> Connection string (URI, session pooler)
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Anthropic (required for AI planning + extraction) ---
ANTHROPIC_API_KEY=
# Optional model overrides
# PLANNER_MODEL=claude-opus-4-8
# EXTRACTION_MODEL=claude-opus-4-8

# --- WhatsApp (Meta Cloud API) — optional until you onboard ---
# WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose
# WHATSAPP_TOKEN=EAAG...          (permanent or temp access token)
# WHATSAPP_PHONE_NUMBER_ID=1234567890

# --- Voice notes (optional): OpenAI Whisper for transcription ---
# OPENAI_API_KEY=

# --- Server ---
PORT=4000
